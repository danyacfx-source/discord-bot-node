{
  "name": "bot-node",
  "version": "1.0.0",
  "description": "Discord-бот, порт с Python на Node.js",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "ramtest": "node scripts/ramtest.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "engineStrict": true,
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.27.0",
    "ws": "^8.18.1"
  },
  "overrides": {
    "ws": "$ws"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "betterSqlite3PrebuildFallback": "prebuild-install --runtime=napi || npm run build-release"
}
