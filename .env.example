# Discord (обязательно) — берётся из CONFIG.token, если не задано
DISCORD_TOKEN=your_discord_bot_token

# Web-панель (конструктор эмбедов)
PANEL_HOST=0.0.0.0
PANEL_PORT=17890
# Пароль для панели (если пусто — доступ без пароля)
PANEL_PASSWORD=
PANEL_PUBLIC_URL=

# YouTube (опционально, интеграция отключена без ключей)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Twitch (опционально). Без них — только анонимный GraphQL fallback.
# Получить: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Прокси для Discord API (необязательно)
DISCORD_PROXY=

# Kick Dev (модерация чата). Токен OAuth от личного аккаунта.
# Скоупы: user:read, moderation:ban, channel:read
KICK_ACCESS_TOKEN=

# ИИ-ответы в Discord-чате — Gemini AI. Ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Совместимость: также читаются GOOGLE_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY
# Легаси (не используется): OPENROUTER_API_KEY=

# Overlay (стрим-оверлей). Токен генерируется автоматически если не задан.
OVERLAY_TOKEN=
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8765

# Discord proxy (необязательно) — если указан, REST идёт через него
# DISCORD_PROXY=http://proxy:8080

# Пути данных (для Docker)
DB_DIR=/app/state
DATA_DIR=/app/state
GUILD_ID=